# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders (expo prebuild)
/ios
/android

# local native module build outputs
/modules/ivy/android/build

# keystores (never commit release.keystore; the standard debug keystore is
# committed so old-tag checkouts build self-contained — see docs/MIGRATIONS.md)
/secrets/*
!/secrets/debug.keystore

# Maestro test artifacts
maestro/screenshots/

# Device screenshots taken by `bin/ivy.ts capture`
captures/

# Generated store assets + release artifacts (`bin/ivy.ts generate` / `prepare`)
dist/

# Git worktrees (standard location; also excluded from jest/tsc/eslint/metro/builds)
/worktrees/

# Server logs
/log/
.claude/

# upgrade-test base APK cache (written by prepare; see docs/MIGRATIONS.md)
/cache/
